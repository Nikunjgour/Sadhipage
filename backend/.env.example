# ========================================================
# ShaadiPage Backend - Environment Variables Template
# Sirf variable NAMES; asli values Render dashboard me set karein (ye file git me jaati hai)
# ========================================================

# Server port — Render apna PORT variable khud inject karta hai
PORT=

# 'production' (Render) ya 'development' (local)
NODE_ENV=

# Allowed frontend origins, comma-separated (CORS ke liye)
# Example: https://shaadipage.vercel.app,https://custom-domain.com
# localhost dev me hi diya jayega (NODE_ENV !== 'production')
CLIENT_URL=

# MongoDB Atlas connection string
# Atlas dashboard -> Cluster -> Connect -> Drivers
MONGO_URI=

# JWT signing secret (strong random string, minimum 32 characters)
JWT_SECRET=

# Cloudinary credentials (cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API key (Google AI Studio)
GEMINI_API_KEY=
