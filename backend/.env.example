# ========================================================
# ShaadiPage Backend - Environment Variables Template
# Har variable ke aage likha hai ki wo value kahan se praapt hogi
# ========================================================

# Server Port (Default 8080 ya 5000 rakhein)
# Ye port aapki local machine ya hosting provider (jaise Render) dwara provide hota hai
PORT=8080

# Node Environment ('development' ya 'production')
NODE_ENV=development

# Allowed Frontend Origins (CORS ke liye comma-separated URLs)
# Local development me Vite ka port (http://localhost:5173) aur deploy ke baad Vercel URL
CLIENT_URL=http://localhost:5173,http://localhost:5000,http://localhost:8080

# MongoDB Atlas Connection URI
# Kahan se milega: MongoDB Atlas dashboard par login karein -> Cluster -> Connect -> 'Drivers' -> connection string copy karein
# Username aur password apna replace karein
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/shaadipage-db?retryWrites=true&w=majority

# JWT Secret Key
# Kahan se milega: Kisi bhi random strong string ko yahan daal sakte hain token encryption ke liye
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# Cloudinary Cloud Name
# Kahan se milega: Cloudinary.com par free account banayein -> Dashboard ke top par 'Cloud Name' dikhega
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API Key
# Kahan se milega: Cloudinary Dashboard me 'API Key' section se copy karein
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API Secret
# Kahan se milega: Cloudinary Dashboard me 'API Secret' (eye icon click karke) copy karein
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI API Key
# Kahan se milega: Google AI Studio (aistudio.google.com) par jayein -> 'Get API key' par click karein aur free key generate karein
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio
